# Copy to .env (never commit .env) or set these as environment variables.
# Leave LLM_PROVIDER empty to replay the saved responses (no key, no network).
#
# LLM_PROVIDER: anthropic | openai | gemini | mistral | openrouter | ollama | lmstudio | replay
LLM_PROVIDER=
# Model name; empty = the provider's suggested model (see src/llm.py PROVIDERS)
LLM_MODEL=
# Your API key (not needed for ollama, lmstudio or replay)
LLM_API_KEY=
# Only if your provider runs somewhere other than its default address
LLM_BASE_URL=
